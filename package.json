{
  "name": "pixso-figma-migration-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Toolkit for migrating Pixso design systems to Figma through Sketch plus migration metadata.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "test": "vitest run",
