    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@figma/plugin-typings": "^1.109.0",
    "@types/node": "^22.10.7",
    "esbuild": "^0.21.5",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
